/* Logic inspired by work from Adam Green
 * (https://github.com/adamgreen/pololu-3pi-plus-2040-arduino-library/blob/main/src/RP2040Encoders.pio).
 */

.program rp2040encoder

.origin 0
    jmp no_change   ; 0000
    jmp increment   ; 0001
    jmp decrement   ; 0010
    jmp no_change   ; 0011
    jmp decrement   ; 0100
    jmp no_change   ; 0101
    jmp no_change   ; 0110
    jmp increment   ; 0111
    jmp increment   ; 1000
    jmp no_change   ; 1001
    jmp no_change   ; 1010
    jmp decrement   ; 1011
    jmp no_change   ; 1100
    jmp decrement   ; 1101
    jmp increment   ; 1110
    jmp no_change   ; 1111

public entry_point:
    mov y, pins     ; Initial encoder state.
    mov x, null     ; Initial counter value.
    mov isr, null   ; Clear ISR.

.wrap_target
    in y, 2         ; Previous encoder state.
    mov y, pins     ; Current encoder state.
    in y, 2         ; Current encoder state.
    mov pc, isr     ; Jump via jump table.

increment:
    mov x, ~x       ; Increment x using x = ~(~x - 1).
    jmp x-- next
next:
    mov x, ~x
    jmp output

decrement:
    jmp x-- output

no_change:
output:
    mov isr, x
    push noblock   ; Push ISR to the RX FIFO and clear it.
.wrap